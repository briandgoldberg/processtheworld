# Database (Prisma Postgres from Vercel Storage). DATABASE_URL is set by the integration;
# PRISMA_ACCELERATE_URL comes from the Prisma Console ("Open in Prisma" on the Storage tab).
DATABASE_URL=
PRISMA_ACCELERATE_URL=

# Claude API (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANALYSIS_MODEL=claude-sonnet-5-5

# Email sign-in links (Resend). The from-address domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Process the World <hello@waitingforpower.com>

# Public URL used in emailed links
APP_URL=https://processtheworld.vercel.app

# Verified emails that can open /admin (comma-separated)
ADMIN_EMAILS=briandgoldberg@gmail.com

# Secret used to hash IP addresses for rate limits
IP_HASH_SALT=
