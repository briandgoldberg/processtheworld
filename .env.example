# Database (Prisma Postgres from Vercel Storage). DATABASE_URL is set by the integration;
# PRISMA_ACCELERATE_URL comes from the Prisma Console ("Open in Prisma" on the Storage tab).
DATABASE_URL=
PRISMA_ACCELERATE_URL=

# Feedback emails (optional, Resend): the feedback button always saves the message; with these it also emails it.
RESEND_API_KEY=
FEEDBACK_TO=
FEEDBACK_FROM=


# Secret used to hash IP addresses for rate limits
IP_HASH_SALT=
