  {
    "title": "Renew a U.S. passport",
    "tags": [
      "government",
      "travel",
      "documents"
    ],
    "thumbnailArt": {
      "emoji": "🛂",
      "hue": 215
    },
    "lanes": [
      {
        "id": "you",
        "name": "You",
        "type": "person"
      },
      {
        "id": "state",
        "name": "U.S. Department of State",
        "type": "person"
      },
      {
        "id": "portal",
        "name": "Online renewal or mail",
        "type": "system"
      }
    ],
    "steps": [
      {
        "id": "a1",
        "lane": "you",
        "label": "Notice your passport expires within a year, or already has",
        "kind": "start",
        "next": [
          "a2"
        ]
      },
      {
        "id": "a2",
        "lane": "you",
        "label": "Is your most recent passport undamaged, issued at 16 or older, in the last 15 years, and in your current name (or can you show a name change)?",
        "kind": "decision",
        "next": [
          {
            "to": "a3",
            "label": "Yes"
          },
          {
            "to": "a10",
            "label": "No"
          }
        ]
      },
      {
        "id": "a3",
        "lane": "you",
        "label": "Can you renew online? (adult, U.S. address, not traveling for several weeks)",
        "kind": "decision",
        "next": [
          {
            "to": "a4",
            "label": "Yes"
          },
          {
            "to": "a5",
            "label": "No, renew by mail"
          }
        ]
      },
      {
        "id": "a4",
        "lane": "portal",
        "label": "Apply online, upload a digital photo and pay by card",
        "next": [
          "a7"
        ]
      },
      {
        "id": "a5",
        "lane": "you",
        "label": "Fill out form DS-82, add a new passport photo and a check for the fee",
        "next": [
          "a6"
        ],
        "pain": {
          "level": 2,
          "note": "Photos get rejected for glasses, shadows or the wrong size"
        }
      },
      {
        "id": "a6",
        "lane": "you",
        "label": "Mail the form, photo, fee and your old passport in a sturdy envelope with tracking",
        "next": [
          "a7"
        ]
      },
      {
        "id": "a7",
        "lane": "state",
        "label": "Process the application (routine or expedited for an extra fee)",
        "next": [
          "a8"
        ],
        "pain": {
          "level": 3,
          "note": "Wait times swing from weeks to months; check current times before you book travel"
        }
      },
      {
        "id": "a8",
        "lane": "portal",
        "label": "Check your application status online",
        "next": [
          "a9"
        ]
      },
      {
        "id": "a9",
        "lane": "state",
        "label": "Mail your new passport; your old one comes back separately",
        "next": [
          "a11"
        ]
      },
      {
        "id": "a10",
        "lane": "you",
        "label": "Apply in person with form DS-11 instead",
        "next": [
          "a11"
        ]
      },
      {
        "id": "a11",
        "lane": "you",
        "label": "Sign your new passport and check the details",
        "kind": "end",
        "next": []
      }
    ]
